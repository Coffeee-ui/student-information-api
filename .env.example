# -----------------------------------------------------------------------------
# Application Environment Variables
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration (Docker Compose Local PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=student_db
POSTGRES_PORT=5432

# Connection string for the local Docker Compose 'db' container
DATABASE_URL=postgresql://postgres:postgres@db:5432/student_db?sslmode=disable

# -----------------------------------------------------------------------------
# Alternative: Remote Supabase / Cloud PostgreSQL (Render)
# -----------------------------------------------------------------------------
# If using Supabase:
# DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# If using Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname.oregon-postgres.render.com/student_db?sslmode=require
