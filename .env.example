# -----------------------------------------------------------------------------
# Application Environment Variables
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration (Docker Compose Local PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=student_db
POSTGRES_PORT=5432

# Connection string for the local Docker Compose 'db' container
DATABASE_URL=postgresql://postgres:postgres@db:5432/student_db?sslmode=disable

# -----------------------------------------------------------------------------
# Alternative: Remote Supabase / External PostgreSQL
# -----------------------------------------------------------------------------
# If using Supabase instead of local postgres container, uncomment and update:
# DATABASE_URL=postgresql://postgres.your-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
